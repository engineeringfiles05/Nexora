{
  // Used by Vercel's function builder (@vercel/node looks for the tsconfig.json nearest the
  // entry point). Vercel transpiles in an isolated context where forced ambient type
  // packages cannot resolve. Imported server dependencies provide the Node declarations;
  // keep browser-only ambient types in the web app's root config.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  "include": ["./**/*.ts"]
}
