rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Only the site owner's account, with an address Firebase has verified, is an administrator
    // (mirrors src/auth/roles.ts). Public registration can never produce an administrator.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'engineeringfiles05@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function optionalString(data, field, maxSize) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxSize);
    }

    // Profile documents: known fields only, with the same limits as the registration form.
    function isValidProfile(data, userId) {
      return data.keys().hasOnly(['id', 'name', 'email', 'role', 'avatar', 'title', 'targetExam', 'examDate',
                                  'enrolledAt', 'course', 'contactNumber', 'authProvider', 'updatedAt',
                                  'status', 'statusReason', 'statusChangedAt', 'lastLoginAt', 'createdBy']) &&
        data.id == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() <= 254 &&
        data.role in ['reviewee', 'admin'] &&
        (!('course' in data) || data.course in ['REE', 'RME'] || data.course == null) &&
        data.get('status', 'active') in ['active', 'pending', 'rejected', 'suspended', 'inactive'] &&
        optionalString(data, 'statusReason', 300) &&
        optionalString(data, 'statusChangedAt', 40) &&
        optionalString(data, 'lastLoginAt', 40) &&
        optionalString(data, 'createdBy', 128) &&
        optionalString(data, 'contactNumber', 20) &&
        optionalString(data, 'avatar', 2048) &&
        optionalString(data, 'title', 120) &&
        optionalString(data, 'targetExam', 200) &&
        optionalString(data, 'examDate', 40) &&
        optionalString(data, 'enrolledAt', 40) &&
        optionalString(data, 'authProvider', 40) &&
        optionalString(data, 'updatedAt', 40);
    }

    // Nobody chooses their own role: every account is a reviewee, except the owner's own profile.
    function isAllowedRole(data, userId) {
      return data.role == 'reviewee' || (data.role == 'admin' && isAdmin() && request.auth.uid == userId);
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Reviewees use review materials only with an approved ("active") profile (see
    // src/auth/accountStatus.ts). Pending, rejected, suspended and deactivated accounts, and
    // accounts without a profile, are refused.
    function isActiveReviewee() {
      return isSignedIn() && exists(profilePath()) && get(profilePath()).data.get('status', 'active') == 'active';
    }

    // The course whose materials this reviewee may use (null: none).
    function myCourse() {
      return get(profilePath()).data.get('course', null);
    }

    // Every self-created profile waits for the administrator's approval. Only the verified site
    // owner's own profile starts active, so the administrator can never be locked out.
    function isAllowedNewStatus(data) {
      return (isAdmin() && data.get('status', 'active') == 'active') || data.get('status', '') == 'pending';
    }

    function unchanged(field) {
      return incoming().get(field, null) == existing().get(field, null);
    }

    // Users Collection
    match /users/{userId} {
      // People can always read their own profile (to learn their status); only the admin lists.
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // An account creates only its own profile, under its own sign-in email...
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidProfile(incoming(), userId) &&
        incoming().email == request.auth.token.email &&
        isAllowedRole(incoming(), userId) &&
        isAllowedNewStatus(incoming()) &&
        !('createdBy' in incoming());
      // ...and the administrator creates reviewee accounts for others.
      allow create: if isAdmin() && isValidId(userId) && request.auth.uid != userId &&
        isValidProfile(incoming(), userId) &&
        incoming().role == 'reviewee';

      // Reviewees edit their own details, never their id, email, enrolment date, role, status or
      // creator. They may pick a course once; after that only the administrator assigns,
      // changes or removes it.
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && !isAdmin() &&
        isValidProfile(incoming(), userId) &&
        incoming().email == existing().email &&
        unchanged('enrolledAt') && unchanged('status') && unchanged('statusReason') &&
        unchanged('statusChangedAt') && unchanged('createdBy') &&
        (unchanged('course') || !('course' in existing())) &&
        incoming().role == 'reviewee';
      // The administrator manages every reviewee, but never blocks or demotes their own account.
      allow update: if isAdmin() && isValidId(userId) &&
        isValidProfile(incoming(), userId) &&
        unchanged('enrolledAt') &&
        isAllowedRole(incoming(), userId) &&
        (request.auth.uid != userId || (incoming().get('status', 'active') == 'active' && incoming().role == 'admin'));
      // Deleting an account: the administrator only, and never their own profile.
      allow delete: if isAdmin() && isValidId(userId) && request.auth.uid != userId;
    }

    // Question Bank Collection
    // Reviewees see published questions of their own course only. Material from before courses
    // existed gets course "REE" when the administrator signs in (src/utils/firebaseSync.ts).
    match /questions/{questionId} {
      allow get: if isValidId(questionId) &&
        (isAdmin() || (isActiveReviewee() && resource.data.isPublished == true && resource.data.course == myCourse()));
      allow list: if isAdmin() ||
        (isActiveReviewee() && resource.data.isPublished == true && resource.data.course == myCourse());
      allow create, update, delete: if isAdmin() && isValidId(questionId);
    }

    // PDF Questionnaires Collection
    match /pdfSources/{pdfSourceId} {
      allow get: if isValidId(pdfSourceId) &&
        (isAdmin() || (isActiveReviewee() && resource.data.isPublicToReviewees == true && resource.data.course == myCourse()));
      allow list: if isAdmin() ||
        (isActiveReviewee() && resource.data.isPublicToReviewees == true && resource.data.course == myCourse());
      allow create, update, delete: if isAdmin() && isValidId(pdfSourceId);
    }

    // Exam Results Collection
    // History stays readable by its owner; only active accounts can add results.
    match /examResults/{resultId} {
      allow get: if isSignedIn() && isValidId(resultId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(resultId) && incoming().userId == request.auth.uid && (isActiveReviewee() || isAdmin());
      allow update: if isValidId(resultId) &&
        ((existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isActiveReviewee()) || isAdmin());
      allow delete: if isAdmin() && isValidId(resultId);
    }

    // Administrative Audit Logs
    // `list` cannot check the document id: a query can't prove isValidId(logId) for every
    // result, so including it would deny the admin's audit-log listener outright.
    match /auditLogs/{logId} {
      allow list: if isAdmin();
      allow get, write: if isAdmin() && isValidId(logId);
    }
  }
}
