# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXORA_ADMIN_TOKEN: Long random secret required for the paid AI routes.
# In production, AI features stay disabled until this is set.
# Admins enter the same value in the PDF Importer.
NEXORA_ADMIN_TOKEN="MY_LONG_RANDOM_SECRET"

# TRUST_PROXY_HOPS: Reverse proxies in front of the app, so rate limits see client addresses.
# TRUST_PROXY_HOPS=1

# Optional AI usage limits, tracked per server process.
# AI_EXTRACT_HOURLY_LIMIT=30
# AI_SOLVE_HOURLY_LIMIT=120
# AI_DAILY_LIMIT=500

# PDF extraction. The PDF's own text layer is always read without AI. With GEMINI_API_KEY,
# scanned pages are read from their page image (twice, at two resolutions) and every text
# page is cross-checked against an independent reading of its image.
# GEMINI_READER_MODEL: model that transcribes page images (transcription only, never solving).
# GEMINI_READER_MODEL=gemini-3.8-flash
# GEMINI_SOLVER_MODEL: model for optional AI answers and solutions, stored apart from the question.
# GEMINI_SOLVER_MODEL=gemini-3.8-flash
# OCR_SINGLE_PASS=true reads scanned pages once instead of twice (cheaper, no self-check).
# OCR_SINGLE_PASS=false
# EXTRACTION_MAX_PARALLEL_JOBS: extraction jobs that may run at the same time.
# EXTRACTION_MAX_PARALLEL_JOBS=2
